# Copy to .env for local docker-compose use. Never commit the real .env.

POSTGRES_DB=bloodhound
POSTGRES_USER=bloodhound
# Generate your own, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-24>

# Signs/validates JWTs. Generate your own, e.g. `openssl rand -base64 48`.
# Central-server warns on startup if this is ever left as a literal example
# value from this file - see JwtService.
JWT_SIGNING_KEY=<generate-with-openssl-rand-base64-48>

# Authenticates the worker to central-server's /api/v1/jobs/** (X-Worker-Api-Key).
# Seeded into worker_credentials on first central-server boot - change it, then
# `docker compose down -v` if you ever rotate it after the DB already has a row.
# Generate your own, e.g. `openssl rand -base64 32`. Central-server warns on
# startup if this is ever left as a literal example value from this file -
# see WorkerCredentialBootstrapRunner.
WORKER_API_KEY=<generate-with-openssl-rand-base64-32>

CENTRAL_SERVER_URL=http://central-server:8080
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=90000

# Bootstrap admin, created once on first boot (only when the users table is
# empty). Change the password before first `docker compose up` in any shared
# environment.
BOOTSTRAP_ORG_NAME=Example Corp
BOOTSTRAP_ORG_SLUG=example-corp
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<choose-a-real-password-before-first-boot>

# Authenticates the worker to ZAP's REST API (internal Docker network only,
# no host port exposed). Generate your own, e.g. `openssl rand -hex 24`.
ZAP_API_KEY=<generate-with-openssl-rand-hex-24>

# Authenticates the worker to the headless-Chromium screenshot sidecar
# (TYPOSQUAT_MONITOR's visual-similarity check, internal Docker network only,
# no host port exposed). Generate your own, e.g. `openssl rand -hex 24`.
SCREENSHOTTER_API_KEY=<generate-with-openssl-rand-hex-24>

# Optional - Have I Been Pwned domain-search API key (BREACH_CORRELATION
# module). Leave unset to disable; the module costs nothing when it's blank
# and makes no HTTP call at all. Requires a paid HIBP subscription
# (https://haveibeenpwned.com/API/Key), and separately, for every domain you
# want breach data on, manually verifying ownership of that domain in your
# HIBP account (dashboard, DNS TXT record, or email approval) - an
# unverified domain returns no data, not an error, no matter how valid the
# key is. See HibpBreachCorrelationSource's javadoc for the full picture.
HIBP_API_KEY=

# SAML SSO - must be the address the *browser* actually reaches these
# services at (not container-network hostnames), since both are embedded in
# browser-facing redirect URLs during the SAML flow.
SAML_SP_BASE_URL=http://localhost:8080
SAML_WEBUI_CALLBACK_URL=http://localhost:8090/sso/callback
