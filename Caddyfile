bloodhound-asm.com, www.bloodhound-asm.com {
    reverse_proxy webui:8080
}

# central-server's MCP + OAuth2 surface, on its own subdomain so it's never reachable through
# bloodhound-asm.com itself. Scoped to just the paths MCP needs (not a bare reverse_proxy to all
# of central-server:8080) - central-server's own SecurityConfig permitAlls /api/v1/auth/** (the
# real login endpoint, issuing raw access+refresh tokens), which webui's ApiProxyController
# deliberately never forwards from the browser side for exactly that reason. An unscoped proxy
# here would quietly undo that protection on this subdomain. Everything else central-server
# serves (/api/v1/**, /scim/v2/**, actuator, swagger) stays unreachable from this site.
mcp.bloodhound-asm.com {
    @mcp {
        path /mcp* /oauth2* /.well-known/* /login*
    }
    reverse_proxy @mcp central-server:8080
    respond 404
}
