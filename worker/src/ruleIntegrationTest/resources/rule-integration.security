# Appended via -Djava.security.properties (no leading '='). Replaces jdk.tls.disabledAlgorithms
# so TlsFetcher can probe SSLv3/TLSv1/TLSv1.1. TLS_RSA_*, RC4, DES and 3DES stay disabled on
# purpose: the suite must not claim TLS_NO_FORWARD_SECRECY or TLS_WEAK_CIPHER_SUITE from them.
# jdk.tls.client.protocols keeps ordinary HttpClient handshakes on TLS 1.2/1.3.
jdk.tls.disabledAlgorithms=DTLSv1.0, RC4, DES, MD5withRSA, DH keySize < 1024, EC keySize < 224, 3DES_EDE_CBC, anon, NULL, ECDH, TLS_RSA_*, rsa_pkcs1_sha1 usage HandshakeSignature, ecdsa_sha1 usage HandshakeSignature, dsa_sha1 usage HandshakeSignature
jdk.tls.client.protocols=TLSv1.3,TLSv1.2
